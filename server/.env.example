# Copier ce fichier en ".env" (non versionné) et renseigner les vraies valeurs.
DB_HOST=localhost
DB_USER=dbgsr
DB_PASSWORD=change_me
DB_NAME=dbgsr
PORT=3000

# `production` active les contrôles de démarrage (secret JWT fort, CORS explicite,
# APP_BASE_URL en https) : le serveur refuse de démarrer sinon.
NODE_ENV=development

# Secret de signature des tokens JWT (chaîne aléatoire longue, jamais partagée).
JWT_SECRET=change_me_to_a_long_random_string

# Origine autorisée à appeler l'API en CORS (ex: https://mon-app.exemple.com).
# Liste séparée par des virgules. Vide en développement = toutes les origines ;
# obligatoire en production (les applications mobiles ne sont pas concernées par CORS).
ALLOWED_ORIGIN=

# Base URL publique du serveur, utilisée pour construire le lien d'activation
# envoyé par email (ex: https://api.mon-domaine.com).
APP_BASE_URL=http://localhost:3000

# SMTP pour l'envoi de l'email d'activation de compte (ex: Gmail, Mailtrap).
# Si SMTP_HOST est vide, le lien d'activation est simplement affiché dans les
# logs du serveur (pratique en développement local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gsrapp.local

# Firebase (Auth, Cloud Messaging, Storage) : optionnel — voir
# FIREBASE_SETUP.md. Sans ce fichier, gsr_app fonctionne normalement
# (aucune synchronisation Firebase, uniquement MySQL).
# Chemin du JSON de compte de service (Console Firebase > Paramètres du
# projet > Comptes de service > Générer une nouvelle clé privée).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Bucket Storage ; déduit de service_account.project_id si vide.
FIREBASE_STORAGE_BUCKET=
